select <- dplyr::select
extract <- raster::extract
# registerDoParallel(cores = 50)
registerDoParallel(cores = 6)
#species
SpeciesList <- read_xlsx("YEAR_3/jt_clim_project/Main_SJ5_JAT_migrants.xlsx", sheet = "Data1_species level")
SpeciesList <- SpeciesList %>% select("Scientific_Name shown in the database", "Migration", "Season") %>%
rename(Species1 = "Scientific_Name shown in the database") %>%
filter(Migration == 3) %>%
distinct(Species1, .keep_all = TRUE)
Birdlife_Birdtree = read_xlsx("YEAR_1/Data/AVONET.xlsx", sheet = "BirdLife–BirdTree crosswalk")
SpeciesList = left_join(SpeciesList, Birdlife_Birdtree, by = "Species1")#converting to Birdtree for jetz ranges
#climate layers
tasmax_summer <- raster("BIG_DATA/bio_clim_layers/tas_min_max/averaged/tasmax_summer.tif")
tasmax_winter <- raster("BIG_DATA/bio_clim_layers/tas_min_max/averaged/tasmax_winter.tif")
tasmin_summer <- raster("BIG_DATA/bio_clim_layers/tas_min_max/averaged/tasmin_summer.tif")
tasmin_winter <- raster("BIG_DATA/bio_clim_layers/tas_min_max/averaged/tasmin_winter.tif")
tasmean_summer <- raster("BIG_DATA/bio_clim_layers/tas_min_max/averaged/tasmean_summer.tif")
tasmean_winter <- raster("BIG_DATA/bio_clim_layers/tas_min_max/averaged/tasmean_winter.tif")
tasmax_summer_25 <- raster::aggregate(tasmax_summer, 25, fun = "mean")
tasmax_winter_25 <- raster::aggregate(tasmax_winter, 25, fun = "mean")
tasmin_summer_25 <- raster::aggregate(tasmin_summer, 25, fun = "mean")
tasmin_winter_25 <- raster::aggregate(tasmin_winter, 25, fun = "mean")
tasmean_summer_25 <- raster::aggregate(tasmean_summer, 25, fun = "mean")
tasmean_winter_25 <- raster::aggregate(tasmean_winter, 25, fun = "mean")
#BL ranges
load("YEAR_3/jt_clim_project/jetz_ranges.RData")
jetz_range_filtered <- subset(jetz_ranges, jetz_ranges$PRESENCE %in% c(1,2,3) & jetz_ranges$ORIGIN %in% c(1,2) & jetz_ranges$SEASONAL %in% c(1,2,3))
jetz_range_filtered <- jetz_range_filtered %>% select(-c("DATE_", "SOURCE", "DATA_SENS", "SENS_COMM", "COMPILER", "TAX_COM", "DIST_COM", "REVIEWERS"))
rm(jetz_ranges)
# i = 2
extracted_clim_df <- foreach(i = 1:nrow(SpeciesList),
.combine = rbind,
.inorder = TRUE,
.packages = c("terra", "sf" ,"raster")) %dopar% {
tryCatch({
print(paste0(i, " out of ", nrow(SpeciesList)))
spp = SpeciesList[i,]
poly_df = jetz_range_filtered[which(jetz_range_filtered$SCINAME == spp$Species3),]
extracted_data_mini_df = data.frame(species = spp$Species3, tas_max_breeding = "", tas_max_wintering = "", tas_mean_breeding = "", tas_mean_wintering = "",tas_min_breeding = "", tas_min_wintering = "")
breeding_poly = poly_df$Shape[-which(poly_df$SEASONAL==3)]
breeding_poly = st_combine(breeding_poly)
breeding_poly = st_as_sf(breeding_poly)
st_crs(breeding_poly) = crs(tasmax_summer)
wintering_poly = poly_df$Shape[-which(poly_df$SEASONAL==2)]
wintering_poly = st_combine(wintering_poly)
wintering_poly = st_as_sf(wintering_poly)
st_crs(wintering_poly) = crs(tasmax_summer)
if(spp$Season == "Boreal"){
#extracting summer climate from breeding range, and winter climate from wintering range
extracted_data_mini_df$tas_max_breeding = extract(tasmax_summer, breeding_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_mean_breeding = extract(tasmean_summer, breeding_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_min_breeding = extract(tasmin_summer, breeding_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_max_wintering = extract(tasmax_winter, wintering_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_mean_wintering = extract(tasmean_winter, wintering_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_min_wintering = extract(tasmin_winter, wintering_poly, mean, na.rm=TRUE)
}
if(spp$Season == "Austral"){
#extracting winter climate from breeding range, and summer climate from wintering range
extracted_data_mini_df$tas_max_breeding = extract(tasmax_winter, breeding_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_mean_breeding = extract(tasmean_winter, breeding_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_min_breeding = extract(tasmin_winter, breeding_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_max_wintering = extract(tasmax_summer, wintering_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_mean_wintering = extract(tasmean_summer, wintering_poly, mean, na.rm=TRUE)
extracted_data_mini_df$tas_min_wintering = extract(tasmin_summer, wintering_poly, mean, na.rm=TRUE)
}
return(extracted_data_mini_df)
}, error=function(e){cat("ERROR :",conditionMessage(e), "\n")})
}
