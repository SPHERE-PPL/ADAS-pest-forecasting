for(i in 1:nrow(PopLambdas)){LambdaVariance = append(LambdaVariance, var(as.numeric(PopLambdas[i,]), na.rm= T))}
for(i in 1:nrow(PopLambdas)){SumLambda = append(SumLambda, sum(as.numeric(PopLambdas[i,]), na.rm= T))}
LambdasDF_FINAL = data.frame(PopID = names(PopLambdas_MEANS),
MeanLambda = PopLambdas_MEANS, SumLambda = SumLambda,
LambdaVariance = LambdaVariance, LambdaResidual = PopLambdas_Residuals$MeanResidual,
LambdaError = PopLambdas_Residuals$StdError, TimeSeriesLenghth = PopLambdas_Residuals$TimeSeriesLength)
row.names(LambdasDF_FINAL) = NULL
trend_meta = POPTrend_DF %>% dplyr::select(ID, Binomial, Latitude, Longitude) %>%
rename(PopID = ID) %>% distinct(PopID, .keep_all = TRUE)
LambdasDF_FINAL = LambdasDF_FINAL %>% left_join(trend_meta, by = "PopID") %>%
select(PopID, Binomial, Latitude, Longitude, MeanLambda, SumLambda, LambdaVariance, LambdaResidual, LambdaError, TimeSeriesLenghth)
LambdasDF_FINAL = LambdasDF_FINAL[-which(LambdasDF_FINAL$MeanLambda==Inf),]
LambdasDF_FINAL = LambdasDF_FINAL[-which(LambdasDF_FINAL$MeanLambda==-Inf),]
mean = mean(LambdasDF_FINAL$MeanLambda, na.rm = T)
sd = sd(LambdasDF_FINAL$MeanLambda, na.rm = T)
T_upp = mean + (3*sd)
T_low = mean - (3*sd)
LambdasDF_FINAL = subset(LambdasDF_FINAL, LambdasDF_FINAL$MeanLambda<T_upp)
LambdasDF_FINAL = subset(LambdasDF_FINAL, LambdasDF_FINAL$MeanLambda>T_low)
length(unique(LambdasDF_FINAL$PopID))
length(unique(LambdasDF_FINAL$Binomial))
write.csv(LambdasDF_FINAL, "Data/LambdasDF_FINAL.csv", row.names = TRUE)
