library(plyr)
library(dplyr)
library(tidyr)
library(mgcv)
s <- mgcv::`s`
setwd("/Users/alexrabeau/Desktop/PHD/YEAR_3/")
#pre processing:
# source("Code/LPI_Processing_v2.R")
# source("Code/AdditionalTrendsData.R")
#read in data:
LPI_proc = read.csv("Data/LPI_processed.csv")
LPI_proc$ID = paste0(as.character(LPI_proc$ID),"L")
BioTIME_proc = read.csv("Data/BioTime_processed.csv")
BioTIME_proc$ID = paste0(as.character(BioTIME_proc$ID),"B")
length(unique(LPI_proc$Binomial))
length(unique(BioTIME_proc$Binomial))
length(unique(LPI_proc$ID))
length(unique(BioTIME_proc$ID))
POPTrend_DF = rbind(LPI_proc, BioTIME_proc)
length(unique(POPTrend_DF$Binomial))
length(unique(POPTrend_DF$ID))
#MeanLambda Processing
all_pops = unique(POPTrend_DF$ID)
all_spp = unique(POPTrend_DF$Binomial)
years = c(min(POPTrend_DF$year):max(POPTrend_DF$year))
PopLambdas = matrix(NA, length(unique(POPTrend_DF$ID)), length(years))
row.names(PopLambdas) = unique(POPTrend_DF$ID)
colnames(PopLambdas) = years
PopLambdas_Residuals = data.frame(PopID = unique(POPTrend_DF$ID), MeanResidual = "", StdError = "", TimeSeriesLength = "")
for(i in 1:length(all_pops)){
tryCatch({
print(paste0(i, " out of ", length(all_pops)))
pops_df = subset(POPTrend_DF, POPTrend_DF$ID == all_pops[i])
pops_df$popvalue[which(pops_df$popvalue==0)] = mean(pops_df$popvalue)*0.01
pops_df$popvalue = pops_df$popvalue %>% log10()
timeSeries_length = length(unique(pops_df$year))
pred_pop_df = data.frame(year = c(min(pops_df$year):max(pops_df$year)), popvalue = "")
if(timeSeries_length>6){
smooth_param = round(timeSeries_length/2)
model <- mgcv::gam(popvalue ~ s(year, k = smooth_param), fx = TRUE, data = pops_df)
rsd <- residuals(model)
modelres <- mgcv::gam(rsd ~ s(year, k = timeSeries_length, bs = "cs"), gamma = 1.4, data = pops_df)
PopLambdas_Residuals$MeanResidual[which(PopLambdas_Residuals$PopID == all_pops[i])] = mean(resid(model))
m = summary(model)
PopLambdas_Residuals$StdError[which(PopLambdas_Residuals$PopID == all_pops[i])] = sqrt(deviance(model)/df.residual(model))#formula for residual standard error
PopLambdas_Residuals$TimeSeriesLength[which(PopLambdas_Residuals$PopID == all_pops[i])] = timeSeries_length
if ((abs(sum(modelres$edf) - 1)) < 0.01) {
pred_popvalue <- predict(model, pred_pop_df)
} else {
model <- lm(popvalue ~ year, data = pops_df)
pred_popvalue <- predict(model, pred_pop_df)
PopLambdas_Residuals$MeanResidual[which(PopLambdas_Residuals$PopID == all_pops[i])] = mean(resid(model))
PopLambdas_Residuals$StdError[which(PopLambdas_Residuals$PopID == all_pops[i])] = sqrt(deviance(model)/df.residual(model))
PopLambdas_Residuals$TimeSeriesLength[which(PopLambdas_Residuals$PopID == all_pops[i])] = timeSeries_length
}
} else {
model <- lm(popvalue ~ year, data = pops_df)
pred_popvalue <- predict(model, pred_pop_df)
PopLambdas_Residuals$MeanResidual[which(PopLambdas_Residuals$PopID == all_pops[i])] = mean(resid(model))
PopLambdas_Residuals$StdError[which(PopLambdas_Residuals$PopID == all_pops[i])] = sqrt(deviance(model)/df.residual(model))
PopLambdas_Residuals$TimeSeriesLength[which(PopLambdas_Residuals$PopID == all_pops[i])] = timeSeries_length
}
lambdas = c()
for(j in 2:length(pred_popvalue)){
n = pred_popvalue[j]
n_1 = pred_popvalue[j-1]
d = log10(n/n_1)
lambdas = append(lambdas, d)
}
PopLambdas[which(rownames(PopLambdas)==all_pops[i]),
c(which(colnames(PopLambdas) %in% c((min(pops_df$year)+1):max(pops_df$year))))] = lambdas
}, error=function(e){cat("ERROR :",conditionMessage(e), "\n")})
}
PopLambdas
#Final DF structuring
PopLambdas_MEANS = rowMeans(PopLambdas, na.rm = TRUE)
PopLambdas_MEANS
LambdaVariance = c()
SumLambda = c()
for(i in 1:nrow(PopLambdas)){LambdaVariance = append(LambdaVariance, var(as.numeric(PopLambdas[i,]), na.rm= T))}
for(i in 1:nrow(PopLambdas)){SumLambda = append(SumLambda, sum(as.numeric(PopLambdas[i,]), na.rm= T))}
LambdaVariance
LambdasDF_FINAL = data.frame(PopID = names(PopLambdas_MEANS),
MeanLambda = PopLambdas_MEANS, SumLambda = SumLambda,
LambdaVariance = LambdaVariance, LambdaResidual = PopLambdas_Residuals$MeanResidual,
LambdaError = PopLambdas_Residuals$StdError, TimeSeriesLenghth = PopLambdas_Residuals$TimeSeriesLength)
View(LambdasDF_FINAL)
row.names(LambdasDF_FINAL) = NULL
trend_meta = POPTrend_DF %>% dplyr::select(ID, Binomial, Latitude, Longitude) %>%
rename(PopID = ID) %>% distinct(PopID, .keep_all = TRUE)
LambdasDF_FINAL = LambdasDF_FINAL %>% left_join(trend_meta, by = "PopID") %>%
select(PopID, Binomial, Latitude, Longitude, MeanLambda, SumLambda, LambdaVariance, LambdaResidual, LambdaError, TimeSeriesLenghth)
LambdasDF_FINAL = LambdasDF_FINAL[-which(LambdasDF_FINAL$MeanLambda==Inf),]
LambdasDF_FINAL = LambdasDF_FINAL[-which(LambdasDF_FINAL$MeanLambda==-Inf),]
mean = mean(LambdasDF_FINAL$MeanLambda, na.rm = T)
sd = sd(LambdasDF_FINAL$MeanLambda, na.rm = T)
T_upp = mean + (3*sd)
T_low = mean - (3*sd)
T_low
LambdasDF_FINAL = subset(LambdasDF_FINAL, LambdasDF_FINAL$MeanLambda<T_upp)
LambdasDF_FINAL = subset(LambdasDF_FINAL, LambdasDF_FINAL$MeanLambda>T_low)
View(LambdasDF_FINAL)
write.csv(LambdasDF_FINAL, "Data/LambdasDF_FINAL.csv", row.names = TRUE)
